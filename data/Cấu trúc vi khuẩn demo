{
  "nodes": [
    { "id": 1, "label": "CẤU TRÚC VÀ HÌNH THÁI HỌC VI KHUẨN", "level": 1, "group": "target", "tooltip": "💡 Anchor: Trụ cột quyết định hình thái, phân loại, độc lực & đề kháng", "detail": "<h3>📌 ANCHOR CHÍNH</h3><p>Khác biệt cấu trúc Thành/Màng & Bộ phận bổ trợ quyết định hình thái, phân loại, độc lực và đề kháng lâm sàng.</p>" },
    
    { "id": 2, "label": "I. Hình Thái Học", "level": 2, "group": "structure", "tooltip": "💡 Hình dạng + Cách sắp xếp", "detail": "<h3>I. Hình thái học tế bào</h3><p>Hình thái = Hình dạng + Cách sắp xếp. Dùng định danh kiểu hình theo Bergey's Manual.</p>" },
    { "id": 3, "label": "II. Thành Phần Bắt Buộc", "level": 2, "group": "structure", "tooltip": "💡 Sự sống còn & Đích tác động kháng sinh", "detail": "<h3>II. Thành phần bắt buộc</h3><p>Gồm 4 bộ phận thiết yếu: Thành, Màng, Ribosome và Thể nhân. Thiếu sót dẫn đến ly giải tế bào.</p>" },
    { "id": 4, "label": "III. Thành Phần Không Bắt Buộc", "level": 2, "group": "structure", "tooltip": "💡 Thích nghi, Độc lực & Chuyển gen ngang", "detail": "<h3>III. Thành phần không bắt buộc</h3><p>Giúp vi khuẩn tăng lực độc, bám dính, né thực bào và truyền gen kháng thuốc.</p>" },
    { "id": 5, "label": "IV. Case Study Lâm Sàng", "level": 2, "group": "target", "tooltip": "💡 Dịch Bạch hầu Việt Nam (2016-2020)", "detail": "<h3>IV. Case Study Lâm sàng: Dịch Bạch hầu</h3><p>Phân tích dịch tễ, phác đồ điều trị và dự phòng dịch Bạch hầu tại Việt Nam.</p>" },

    { "id": 6, "label": "Cầu khuẩn (Cocci)", "level": 3, "group": "structure", "tooltip": "💡 Cầu, Bầu dục, Lõm 1 cạnh", "detail": "<h3>🔴 Cầu khuẩn (Cocci)</h3><ul><li><b>Hình dạng:</b> Cầu (<i>Staphylococcus</i>), Bầu dục (<i>S. faecalis</i>), Lõm một cạnh (<i>Neisseria</i>).</li><li><b>Sắp xếp:</b> Riêng lẻ, Cặp đôi (Diplococci), Chuỗi (Streptococci), Cụm 4 (Tetrads), Khối 8 (Sarcina), Tụ chùm (Staphylococci).</li></ul>" },
    { "id": 7, "label": "Trực khuẩn (Bacilli)", "level": 3, "group": "structure", "tooltip": "💡 Que dài, Que ngắn", "detail": "<h3>🟢 Trực khuẩn (Bacilli)</h3><ul><li><b>Hình dạng:</b> Que dài ~20µm (<i>B. subtilis</i>), Que ngắn ~0.5µm (Coccobacilli).</li><li><b>Sắp xếp:</b> Riêng rẽ, Cặp đôi (Diplobacilli), Chuỗi dài (Streptobacilli), Hàng rào/Chữ V (<i>Corynebacterium</i>).</li></ul>" },
    { "id": 8, "label": "Xoắn khuẩn (Spiral)", "level": 3, "group": "structure", "tooltip": "💡 Phẩy, Xoắn vừa, Spirochetes", "detail": "<h3>🌊 Xoắn khuẩn (Spiral)</h3><ul><li><b>Hình dạng:</b> Dấu phẩy (<i>Vibrio</i>), Xoắn vừa (<i>Spirillum</i>), Xoắn ốc (<i>Spirochetes</i>).</li><li><b>Sắp xếp:</b> Luôn luôn sắp xếp RIÊNG LẺ.</li></ul>" },

    { "id": 9, "label": "1. Thành Tế Bào (Cell Wall)", "level": 3, "group": "structure", "tooltip": "💡 Khung Peptidoglycan (NAG-NAM)", "detail": "<h3>🧱 Thành Tế Bào</h3><p>Cấu tạo chủ yếu từ Peptidoglycan. Giúp giữ vững hình dạng và chống chịu áp suất thẩm thấu.</p>" },
    { "id": 10, "label": "Gram Dương (+)", "level": 4, "group": "structure", "tooltip": "💡 Peptidoglycan dày ~25nm + Acid Teichoic", "detail": "<h3>🟣 Gram Dương (+)</h3><p>Lớp Peptidoglycan rất dày (~25nm), bền vững vật lý. Chứa Acid Teichoic & Lipoteichoic kích hoạt miễn dịch.</p>" },
    { "id": 11, "label": "Gram Âm (-)", "level": 4, "group": "structure", "tooltip": "💡 Peptidoglycan mỏng ~3nm + Màng ngoài OM", "detail": "<h3>🔴 Gram Âm (-)</h3><p>Peptidoglycan mỏng (~3nm). Có khoảng Periplasma và Màng ngoài OM chứa Lipopolysaccharide (LPS).</p>" },
    { "id": 12, "label": "Ngoại Lệ Cấu Trúc Thành", "level": 4, "group": "resistance", "tooltip": "💡 Mycoplasma, Mycobacterium...", "detail": "<h3>⚠️ Ngoại lệ cấu trúc thành</h3><ul><li><b>Mycoplasma / Ureaplasma:</b> KHÔNG có vách peptidoglycan.</li><li><b>Mycobacterium / Nocardia:</b> Chứa Acid Mycolic + Arabinogalactan + LAM.</li><li><b>L-form:</b> Protoplast/Spheroplast còn khả năng phân chia.</li></ul>" },

    { "id": 13, "label": "Màng Ngoài OM & LPS", "level": 5, "group": "structure", "tooltip": "💡 Lipid A (Nội độc tố) + Kháng nguyên O", "detail": "<h3>🛡️ Màng ngoài OM & LPS</h3><ul><li><b>Lipid A:</b> Nội độc tố Gram âm, gắn TLR4 gây sốc nhiễm khuẩn và bão cytokine.</li><li><b>Polysaccharide O:</b> Mang tính kháng nguyên bề mặt đặc trưng dùng định danh dịch tễ.</li></ul>" },
    { "id": 14, "label": "Kênh Porin Xuyên Màng", "level": 5, "group": "structure", "tooltip": "💡 Cửa ngõ vận chuyển chất thân nước", "detail": "<h3>🚪 Kênh Porin</h3><p>Cho phép chất thân nước nhỏ và kháng sinh thấm qua. Vi khuẩn có thể biến đổi Porin để đề kháng.</p>" },

    { "id": 15, "label": "Enzyme Transpeptidase (PBP)", "level": 4, "group": "mechanism", "tooltip": "💡 Xúc tác tạo liên kết chéo Peptidoglycan", "detail": "<h3>🛠️ Enzyme PBP</h3><p>Đích tác động chính của kháng sinh nhóm Beta-lactam và Glycopeptide.</p>" },
    { "id": 16, "label": "Kháng Sinh Beta-lactam", "level": 3, "group": "application", "tooltip": "💡 Penicillin, Cephalosporin...", "detail": "<h3>💊 Kháng sinh Beta-lactam</h3><p>Ức chế không thuận nghịch PBP. Rất an toàn, phổ rộng, là lựa chọn đầu tay trên lâm sàng.</p>" },
    { "id": 17, "label": "Kháng Sinh Glycopeptide (Vancomycin)", "level": 3, "group": "application", "tooltip": "💡 Cạnh tranh đầu D-Ala-D-Ala", "detail": "<h3>💊 Vancomycin</h3><p>Cạnh tranh vị trí bám D-Ala-D-Ala. Chuyên trị cầu khuẩn Gram(+) kháng thuốc (MRSA).</p>" },
    { "id": 18, "label": "Kháng Tự Nhiên Ở Gram Âm", "level": 5, "group": "resistance", "tooltip": "💡 Vancomycin không qua được màng OM", "detail": "<h3>🛡️ Đề kháng tự nhiên</h3><p>Phân tử Vancomycin quá bự (gấp 5-7 lần Beta-lactam) nên không chui qua được màng ngoài OM của Gram âm.</p>" },

    { "id": 19, "label": "2. Màng Tế Bào Chất", "level": 3, "group": "structure", "tooltip": "💡 Lớp Phospholipid kép + Protein (Không Sterol)", "detail": "<h3>🌊 Màng Tế Bào Chất</h3><p>Kiểm soát trao đổi chất, hô hấp tế bào (ATP) và phân bào. Không chứa Sterol (khác người/nấm).</p>" },
    { "id": 20, "label": "Kháng Sinh Colistin (Polymyxin)", "level": 3, "group": "application", "tooltip": "💡 Gắn Lipid A gây ly giải màng Gram(-)", "detail": "<h3>💊 Colistin</h3><p>Tương tác Lipid A mồi để vào ly giải màng Gram âm. Độc tính cao trên Thận và Thần kinh người.</p>" },
    { "id": 21, "label": "Bơm Đẩy Ngược (Efflux Pump)", "level": 4, "group": "resistance", "tooltip": "💡 Bơm RND 3 thành phần (MexAB-OprM)", "detail": "<h3>🛡️ Hệ thống Bơm Đẩy Ngược</h3><p>Nằm trên màng, chủ động bơm kháng sinh ra ngoài. Gây ra hiện tượng đa kháng thuốc (MDR) cực kỳ nguy hiểm.</p>" },

    { "id": 22, "label": "3. Ribosome 70S", "level": 3, "group": "structure", "tooltip": "💡 Tiểu đơn vị 30S + 50S", "detail": "<h3>🧬 Ribosome 70S</h3><p>Nhà máy sinh tổng hợp protein gồm 30S (16S rRNA) và 50S.</p>" },
    { "id": 23, "label": "Ức Chế Dịch Mã 50S & 30S", "level": 4, "group": "application", "tooltip": "💡 Macrolides, Tetracyclines (Kìm khuẩn)", "detail": "<h3>💊 Kháng sinh Kìm khuẩn</h3><p>Macrolides, Clindamycin (gắn 50S), Tetracyclines (gắn 30S) -> Ức chế dịch mã thuận nghịch.</p>" },
    { "id": 24, "label": "Kháng Sinh Aminoglycoside", "level": 4, "group": "application", "tooltip": "💡 Đọc sai mã Codon -> Diệt khuẩn", "detail": "<h3>💊 Aminoglycoside</h3><p>Gắn 30S làm đọc sai mã codon mRNA -> Tạo protein rác gây rối loạn tế bào -> Diệt khuẩn không đảo nghịch.</p>" },

    { "id": 25, "label": "4. Thể Nhân (Nucleoid)", "level": 3, "group": "structure", "tooltip": "💡 1 NST ADN vòng kép, đơn bội", "detail": "<h3>🧬 Thể Nhân</h3><p>Chứa 1 NST ADN vòng kép, không màng nhân, không có Histone. Diễn ra hiện tượng Transertion đồng thời.</p>" },
    { "id": 26, "label": "Enzyme DNA Gyrase & Topo IV", "level": 4, "group": "mechanism", "tooltip": "💡 Tháo xoắn và cắt nối ADN", "detail": "<h3>🛠️ DNA Gyrase & Topoisomerase IV</h3><p>Tiểu đơn vị GyrA/ParC chịu trách nhiệm cắt tháo xoắn và nối lại mạch ADN khi sao chép.</p>" },
    { "id": 27, "label": "Kháng Sinh Quinolone (Fluoroquinolone)", "level": 3, "group": "application", "tooltip": "💡 Đóng băng trạng thái cắt -> Đứt gãy ADN", "detail": "<h3>💊 Quinolones</h3><p>Ức chế hoạt tính nối của GyrA/ParC -> Đóng băng trạng thái cắt -> Đứt gãy ADN -> Chết tế bào.</p>" },
    { "id": 28, "label": "Sulfamethoxazole & Trimethoprim", "level": 3, "group": "application", "tooltip": "💡 Ức chế tổng hợp Acid Folic", "detail": "<h3>💊 Cotrimoxazole (Bactrim)</h3><p>Ức chế 2 chặng liên tiếp con đường tổng hợp Acid Folic từ PABA -> Cắt nguồn nguyên liệu ADN.</p>" },

    { "id": 29, "label": "1. Nang (Capsule)", "level": 3, "group": "structure", "tooltip": "💡 Kháng nguyên K, trốn thực bào", "detail": "<h3>🛡️ Nang (Capsule)</h3><p>Lớp Polysaccharide đậm đặc. Ức chế thực bào, làm tăng độc lực mạnh. Chiết xuất sản xuất Vaccine.</p>" },
    { "id": 30, "label": "2. Glycocalyx & Biofilm", "level": 3, "group": "structure", "tooltip": "💡 Chất keo bám dính & Màng sinh học", "detail": "<h3>🧫 Glycocalyx & Biofilm</h3><p>Polysaccharide lỏng lẻo giúp bám dính mô. Tạo màng Biofilm trên ống dẫn/máy thở gây nhiễm trùng bệnh viện (VAP).</p>" },
    { "id": 31, "label": "3. Tiêm Mao (Flagella)", "level": 3, "group": "structure", "tooltip": "💡 Kháng nguyên H, động cơ bơi", "detail": "<h3>🏊 Tiêm Mao (Flagella)</h3><p>Giúp vi khuẩn bơi (Runs/Tumbles). *Proteus* nhờ tiêm mao bơi ngược dòng nước tiểu gây UTI.</p>" },
    { "id": 32, "label": "4. Pili (Fimbriae)", "level": 3, "group": "structure", "tooltip": "💡 Pili bám & Sex Pilus", "detail": "<h3>🔌 Pili</h3><ul><li><b>Pili thường:</b> Giúp bám biểu mô.</li><li><b>Sex pilus:</b> Tạo cầu nối tiếp hợp truyền Plasmid.</li></ul>" },
    { "id": 33, "label": "5. Plasmid & Gen Đề Kháng", "level": 3, "group": "resistance", "tooltip": "💡 Plasmid R mang gen kháng thuốc", "detail": "<h3>🧬 Plasmid & Transposon</h3><p>ADN ngoài nhân sao chép độc lập. Plasmid R chứa gen kháng thuốc, kết hợp Transposon (gen nhảy) tạo Mega-plasmid.</p>" },
    { "id": 34, "label": "6. Bào Tử (Endospore)", "level": 3, "group": "resistance", "tooltip": "💡 Dạng sinh tồn Gram(+) cực hạn", "detail": "<h3>🔥 Bào Tử (Endospore)</h3><p>Dạng sinh tồn Gram(+). Chứa Acid Dipicolinic + Ca2+. Kháng nhiệt/UV cực hạn (Hấp 121°C/20ph hoặc Sấy 165-200°C/2h).</p>" },

    { "id": 35, "label": "Dịch Tễ & Lây Truyền", "level": 3, "group": "target", "tooltip": "💡 Tây Nguyên 2020: 198 ca", "detail": "<h3>📊 Dịch tễ Bạch hầu</h3><p>Đỉnh dịch 2020: 198 ca dương tính (138 ca bệnh, 60 người lành mang trùng). Lây qua giọt bắn, khí dung, tiếp xúc.</p>" },
    { "id": 36, "label": "Phác Đồ Điều Trị Bạch Hầu", "level": 3, "group": "application", "tooltip": "💡 Penicillin G / Macrolide + SAD", "detail": "<h3>🏥 Điều trị Bạch hầu</h3><p>Kháng sinh Penicillin G hoặc Macrolide + Huyết thanh kháng độc tố SAD trung hòa độc tố + Điều trị bảo tồn.</p>" },
    { "id": 37, "label": "Phác Đồ Dự Phòng Bạch Hầu", "level": 3, "group": "application", "tooltip": "💡 Erythromycin / Benzathine + Vaccine DTaP/Tdap", "detail": "<h3>🛡️ Dự phòng Bạch hầu</h3><p>Người tiếp xúc: Benzathine Penicillin G IM hoặc Erythromycin. Vaccine DTaP (trẻ nhỏ), Tdap (trẻ lớn), Td/Tdap (người lớn).</p>" }
