{
  "nodes": [
    { "id": 1, "label": "CÔNG NGHỆ SẢN XUẤT & CÔNG NGHỆ NGHIỀN", "level": 1, "group": "target", "tooltip": "💡 Anchor: Tổng quan quy trình công nghệ & Kỹ thuật giảm kích thước tiểu phân", "detail": "<h3>📌 CÔNG NGHỆ DƯỢC PHẨM</h3><p>Nghiên cứu quy trình chuyển hóa từ nguyên liệu ban đầu thành dạng chế phẩm thương mại, tập trung vào kỹ thuật kiểm soát kích thước tiểu phân bằng công nghệ nghiền.</p>" },

    { "id": 2, "label": "I. Lưu Đồ Sản Xuất (Flow Chart)", "level": 2, "group": "structure", "tooltip": "💡 Trình tự các quá trình công nghệ", "detail": "<h3>📜 Lưu đồ sản xuất (Flow chart)</h3><p>Biểu diễn trình tự thời gian các công đoạn sản xuất. Yêu cầu thống nhất 100% quy chuẩn biểu diễn (Châu Âu: Ô chữ nhật = Bán thành phẩm; Ấn Độ: Ô chữ nhật = Hành động).</p>" },
    { "id": 3, "label": "II. Động Học Hòa Tan & Đường Dùng", "level": 2, "group": "mechanism", "tooltip": "💡 Phương trình Noyes-Whitney & Kích thước hạt", "detail": "<h3>🧬 Động học hòa tan & Hấp thu</h3><p>Nghiền làm tăng diện tích bề mặt tiếp xúc (S) theo hàm số mũ, từ đó thúc đẩy tốc độ hòa tan (dC/dt) theo phương trình Noyes-Whitney.</p>" },
    { "id": 4, "label": "III. Động Học & Cơ Chế Nghiền", "level": 2, "group": "mechanism", "tooltip": "💡 4 Giai đoạn biến dạng & 4 Cơ chế vật lý", "detail": "<h3>⚙️ Động học & Cơ chế nghiền</h3><p>Nghiền diễn ra qua 4 giai đoạn biến dạng. Lực nghiền phụ thuộc vào Phương và Thời gian tác dụng để tạo ra 4 cơ chế vật lý cơ bản.</p>" },
    { "id": 5, "label": "IV. Hệ Thống Thiết Bị Nghiền", "level": 2, "group": "application", "tooltip": "💡 Dụng cụ nhỏ & Thiết bị quy mô công nghiệp", "detail": "<h3>🛠️ Thiết bị nghiền công nghiệp</h3><p>Lựa chọn thiết bị dựa trên tính chất vật liệu (độ cứng, tính giòn, độ dẻo) và độ nhạy cảm với nhiệt độ của hoạt chất.</p>" },

    { "id": 6, "label": "Các Bước Tạo Hạt Ướt Viên Nén", "level": 3, "group": "structure", "tooltip": "💡 Quy trình 6 bước chuẩn hóa", "detail": "<h3>🧱 Quy trình xát hạt ướt</h3><ol><li>Cân - Rây - Nghiền nguyên liệu (API + Tá dược)</li><li>Trộn bột khô</li><li>Trộn bột ướt (thêm tá dược dính)</li><li>Xát hạt ướt -> Cốm ướt</li><li>Sấy cốm -> Cốm khô</li><li>Sửa hạt & Trộn hoàn tất -> Dập viên / Đóng nang</li></ol>" },
    { "id": 7, "label": "Tá Dược Rã Nội vs Rã Ngoại", "level": 4, "group": "mechanism", "tooltip": "💡 Phối hợp ở giai đoạn bột khô vs trộn hoàn tất", "detail": "<h3>🧪 Phân biệt Tá dược rã</h3><ul><li><b>Rã nội:</b> Trộn ngay từ bước bột khô, giúp rã hạt cốm thành bột mịn trong dạ dày.</li><li><b>Rã ngoại:</b> Trộn ở bước hoàn tất, giúp rã viên nén thành các hạt cốm rời.</li></ul>" },

    { "id": 8, "label": "Phương Trình Noyes-Whitney", "level": 3, "group": "mechanism", "tooltip": "💡 dC/dt = (D * S / h) * (Cs - Ct)", "detail": "<h3>📐 Phương trình Noyes-Whitney</h3><p><b>dC/dt = (D × S / h) × (Cs - Ct)</b></p><p>Độ tan (Cs) là đại lượng cố định. Tốc độ hòa tan (dC/dt) phụ thuộc trực tiếp vào Diện tích bề mặt tiếp xúc (S).</p>" },
    { "id": 9, "label": "Diện Tích Bề Mặt Tiếp Xúc (S)", "level": 4, "group": "structure", "tooltip": "💡 Tăng vọt theo hàm số mũ khi giảm kích thước", "detail": "<h3>📐 Tăng diện tích bề mặt (S)</h3><p>Khi giảm kích thước hạt đi 3 lần, tổng diện tích bề mặt S' tăng lên 3 lần. Giảm hạt càng nhỏ, S tăng vọt giúp dược chất kém tan hòa tan siêu tốc.</p>" },
    { "id": 10, "label": "Sinh Khả Dụng & Khởi Phát Tác Dụng", "level": 4, "group": "application", "tooltip": "💡 Rút ngắn thời gian xuất hiện trong máu", "detail": "<h3>⚡ Khởi phát tác dụng điều trị</h3><p>Ví dụ Paracetamol siêu mịn: Viên rã trong 2 phút, hòa tan bão hòa trong 2 phút -> Bắt đầu có tác dụng giảm đau chỉ sau 5-7 phút.</p>" },
    { "id": 11, "label": "Kích Thước Hạt Theo Đường Dùng", "level": 3, "group": "application", "tooltip": "💡 Hít phế nang < 5µm, Tiêm IV < 2µm, Nhỏ mắt < 3µm", "detail": "<h3>🎯 Kích thước tiểu phân mục tiêu</h3><ul><li><b>Thuốc hít phế nang (Aerosol):</b> 1.0 - 5.0 µm (Tránh va đập cổ họng).</li><li><b>Thuốc nhỏ mắt (Ocular):</b> 0.1 - 3.0 µm (Tránh kích ứng cơ học).</li><li><b>Tiêm tĩnh mạch (IV):</b> 0.1 - 2.0 µm (Tránh tắc mạch).</li></ul>" },

    { "id": 12, "label": "4 Giai Đoạn Biến Dạng Vật Liệu", "level": 3, "group": "mechanism", "tooltip": "💡 Đàn hồi -> Vết nứt vi mô -> Lan truyền -> Vỡ vụn", "detail": "<h3>🔨 Tiến trình vỡ vụn tiểu phân</h3><ol><li>Biến dạng đàn hồi (Elastic)</li><li>Tạo vết nứt vi mô (Crack formation)</li><li>Lan truyền vết nứt (Crack propagation)</li><li>Vỡ vụn (Fracture/Breakage)</li></ol>" },
    { "id": 13, "label": "4 Cơ Chế Nghiền Vật Lý", "level": 3, "group": "mechanism", "tooltip": "💡 Va đập, Nén, Chà xát, Cắt-xé", "detail": "<h3>⚙️ 4 Cơ chế nghiền cơ bản</h3><ul><li><b>Va đập (Impact):</b> Lực hướng tâm + Thời gian ngắn.</li><li><b>Nén (Compression):</b> Lực hướng tâm + Thời gian dài.</li><li><b>Chà xát (Attrition):</b> Lực tiếp tuyến + Thời gian dài.</li><li><b>Cắt - xé (Cutting):</b> Lực tiếp tuyến + Thời gian ngắn.</li></ul>" },
    { "id": 14, "label": "Độ Nghiền (i = D/d) & Động Học", "level": 3, "group": "mechanism", "tooltip": "💡 Kích thước càng mịn, thời gian nghiền kéo dài theo hàm số mũ", "detail": "<h3>📊 Động học quá trình nghiền</h3><p>Phương trình <b>dD/dt = -k * D^n</b>. Hạt càng mịn (nghiền mịn n=2), thời gian cần thiết để giảm một nửa kích thước hạt càng kéo dài dốc đứng.</p>" },

    { "id": 15, "label": "Cối Chày (Quy Mô Nhỏ)", "level": 3, "group": "application", "tooltip": "💡 Cối nhám nghiền hạt, Cối trơn trộn lỏng", "detail": "<h3>🧪 Dụng cụ Cối Chày</h3><ul><li><b>Cối sứ/thủy tinh nhám:</b> Tạo ma sát cơ học để nghiền hạt.</li><li><b>Cối thủy tinh trơn:</b> Trộn chất lỏng/thuốc mỡ (không nghiền được).</li><li><b>Cối đá mã não:</b> Bề mặt siêu cứng, dùng cho chất tinh khiết.</li></ul>" },
    { "id": 16, "label": "Máy Nghiền Búa (Hammer Mill)", "level": 3, "group": "application", "tooltip": "💡 Cơ chế Va Đập (Impact) tốc độ cao", "detail": "<h3>🔨 Máy nghiền búa</h3><p>Dùng búa quay tốc độ cao đập vỡ hạt giòn cứng. Cải tiến lưới rây Omega (thêm chà xát) và luồng khí thổi chống nghẽn bột lơ lửng.</p>" },
    { "id": 17, "label": "Máy Nghiền Bi (Ball Mill)", "level": 3, "group": "application", "tooltip": "💡 Va Đập + Chà Xát, Tốc độ tới hạn Nc", "detail": "<h3>🟢 Máy nghiền bi</h3><p>Trống quay chứa bi (40-50% thể tích). Vận hành ở 70-80% Tốc độ tới hạn (Nc = 42.3 / √D) để tạo thể thác rơi (Cascade).</p>" },
    { "id": 18, "label": "Rủi Ro Ma Sát Nhiệt & Vô Định Hình", "level": 4, "group": "resistance", "tooltip": "💡 CẤM dùng máy nghiền bi cho chất nhạy nhiệt/protein", "detail": "<h3>⚠️ CẢNH BÁO: Ma sát nhiệt cao</h3><p>Máy nghiền bi sinh nhiệt ma sát khổng lồ. <b>CẤM DÙNG</b> cho chất có nhiệt độ nóng chảy thấp (<90°C), chất nhạy nhiệt, Protein, Enzyme, mAbs (gây phân hủy/vô định hình hóa).</p>" },
    { "id": 19, "label": "Máy Nghiền Phản Lực (Jet Mill)", "level": 3, "group": "application", "tooltip": "💡 Tự va đập dòng khí nén + Bánh xe phân loại", "detail": "<h3>💨 Máy nghiền năng lượng động (Jet Mill)</h3><p>Sử dụng 3 súng phun khí nén góc 120° tạo lốc xoáy cho hạt tự va đập. Kiểm soát kích thước hạt tối đa bằng Bánh xe phân loại quay ở tâm.</p>" },
    { "id": 20, "label": "Ưu Thế Bảo Vệ Hoạt Chất Nhạy Nhiệt", "level": 4, "group": "application", "tooltip": "💡 Khí nén giãn nở thu nhiệt làm mát buồng nghiền", "detail": "<h3>❄️ Giải pháp cho chất nhạy nhiệt</h3><p>Hạt tự va đập không ma sát kim loại + Khí nén giãn nở thu nhiệt làm mát tự động. Lựa chọn tối thượng cho Protein, Enzyme, mAbs.</p>" }
