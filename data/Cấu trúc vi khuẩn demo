{
  "nodes": [
    { "id": 1, "label": "QUÁ TRÌNH CÔNG NGHỆ & CÔNG NGHỆ NGHIỀN", "level": 1, "group": "target", "tooltip": "💡 Anchor: Quy trình sản xuất tổng thể & Kỹ thuật giảm kích thước tiểu phân", "detail": "<h3>📌 ANCHOR BÀI HỌC</h3><p>Môn Công nghiệp dược giải quyết bài toán quy mô lớn: Lựa chọn thiết bị, xác lập thông số vận hành và liên kết các quá trình riêng lẻ thành dây chuyền sản xuất đạt tiêu chuẩn GMP (Nhân sự, Nhà xưởng, Hồ sơ, Đánh giá máy).</p>" },

    { "id": 2, "label": "I. Lưu Đồ Sản Xuất (Flow Chart)", "level": 2, "group": "structure", "tooltip": "💡 Trình tự các bước theo thời gian", "detail": "<h3>📜 I. Lưu Đồ Sản Xuất (Flow Chart)</h3><p>Trang đầu tiên trong hồ sơ thầu kỹ thuật bệnh viện. Dược sĩ bắt buộc phải thành thạo kỹ năng đọc lưu đồ.</p><ul><li><b>Quy chuẩn Châu Âu:</b> Ô chữ nhật = Bán thành phẩm / Đối tượng; Mũi tên = Hành động.</li><li><b>Quy chuẩn Ấn Độ:</b> Ô chữ nhật = Hành động / Quá trình; Mũi tên = Đối tượng.</li><li><b>⚠️ Bẫy thi:</b> Bắt buộc thống nhất 100% một quy chuẩn, không được pha trộn.</li></ul>" },
    { "id": 3, "label": "II. Động Học Hòa Tan & Đường Dùng", "level": 2, "group": "mechanism", "tooltip": "💡 Phương trình Noyes-Whitney & Phân bố hạt", "detail": "<h3>🧬 II. Động Học Hòa Tan & Đường Dùng</h3><p>Giảm kích thước tiểu phân làm tăng diện tích bề mặt tiếp xúc (S) theo hàm số mũ, trực tiếp thúc đẩy tốc độ hòa tan (dC/dt) theo phương trình Noyes-Whitney.</p>" },
    { "id": 4, "label": "III. Động Học & Cơ Chế Nghiền", "level": 2, "group": "mechanism", "tooltip": "💡 Biến dạng vật liệu & 4 Cơ chế lực vật lý", "detail": "<h3>⚙️ III. Động Học & Cơ Chế Nghiền</h3><p>Nghiền là áp dụng lực cơ học làm vỡ tiểu phân đơn lẻ. Phân biệt với <i>Sửa hạt</i> (chia nhỏ cốm vón) và <i>Tạo hạt</i> (tăng kích thước có kiểm soát).</p>" },
    { "id": 5, "label": "IV. Thiết Bị Nghiền Công Nghiệp", "level": 2, "group": "application", "tooltip": "💡 Lựa chọn thiết bị theo bản chất vật liệu & nhiệt", "detail": "<h3>🛠️ IV. Thiết Bị Nghiền Công Nghiệp</h3><p>Bộ phận tiếp xúc trực tiếp với thuốc BẮT BUỘC làm bằng Thép không gỉ (Inox 316 hoặc 316L). Khung vỏ ngoài dùng Inox 304.</p>" },

    { "id": 6, "label": "Quy Trình Xát Hạt Ướt Viên Nén", "level": 3, "group": "structure", "tooltip": "💡 6 bước từ Bột khô đến Cốm hoàn tất", "detail": "<h3>🧱 Quy trình 6 bước Xát hạt ướt</h3><ol><li><b>Cân - Rây - Nghiền:</b> Chuẩn bị API và tá dược ban đầu.</li><li><b>Trộn bột khô:</b> Phối hợp API + Tá dược độn + Tá dược rã nội.</li><li><b>Trộn bột ướt:</b> Thêm dung dịch tá dược dính lỏng (đã khuấy hòa tan).</li><li><b>Xát hạt ướt:</b> Ép qua lưới tạo hỗn hợp cốm ướt.</li><li><b>Sấy cốm:</b> Loại bỏ nước/dung môi đưa hàm ẩm về mức an toàn.</li><li><b>Sửa hạt & Trộn hoàn tất:</b> Chia nhỏ cốm vón, trộn tá dược trơn + Tá dược rã ngoại -> Dập viên / Đóng nang.</li></ol>" },
    { "id": 7, "label": "Tá Dược Rã Nội vs Rã Ngoại", "level": 4, "group": "mechanism", "tooltip": "💡 Bẫy trắc nghiệm vai trò giai đoạn rã", "detail": "<h3>🧪 Bẫy trắc nghiệm: Tá dược rã</h3><ul><li><b>Tá dược rã nội:</b> Trộn ở Bước 2 (bột khô) -> Rã hạt cốm thành bột mịn trong dạ dày.</li><li><b>Tá dược rã ngoại:</b> Trộn ở Bước 6 (trộn hoàn tất) -> Rã viên nén thành các hạt cốm rời.</li></ul>" },

    { "id": 8, "label": "Phương Trình Noyes-Whitney", "level": 3, "group": "mechanism", "tooltip": "💡 dC/dt = (D * S / h) * (Cs - Ct)", "detail": "<h3>📐 Phương trình Noyes-Whitney</h3><p><b>dC/dt = (D × S / h) × (Cs - Ct)</b></p><ul><li><b>Cs (Độ tan bão hòa):</b> Đại lượng cố định theo cấu trúc hóa học, không thể thay đổi.</li><li><b>dC/dt (Tốc độ hòa tan):</b> Đại lượng động, tăng vọt khi diện tích bề mặt S tăng.</li><li><b>Chứng minh toán học:</b> Giảm cạnh hạt a xuống 3 lần -> Tổng diện tích S' tăng 3 lần. Giảm hạt bao nhiêu lần, S tăng bấy nhiêu lần.</li></ul>" },
    { "id": 9, "label": "Khởi Phát Tác Dụng Siêu Tốc", "level": 4, "group": "application", "tooltip": "💡 Ví dụ Paracetamol & Đường Sucrose Zinnat", "detail": "<h3>⚡ Ứng dụng thực chiến sản xuất</h3><ul><li><b>Paracetamol siêu mịn:</b> Viên rã 2 phút, hòa tan 2 phút -> Giảm đau sau 5-7 phút (so với 30 phút ở viên thông thường).</li><li><b>Nghiền đường Sucrose (Zinnat):</b> Nghiền đường hạt thành bột siêu mịn trước khi trộn với Cefuroxime axetil mịn để che vị đắng, tránh phân lớp hỗn dịch.</li><li><b>Minh chứng Cilostazol:</b> Dạng NanoCrystal (0.1-0.4µm) hòa tan 100% < 1 phút; Jet-milled (1-10µm) hòa tan 90%/30ph; Hammer-milled (1-100µm) chỉ hòa tan 40%/60ph.</li></ul>" },
    { "id": 10, "label": "Tiêu Chuẩn Kích Thước Đường Dùng", "level": 3, "group": "application", "tooltip": "💡 Phế nang <5µm, Mắt <3µm, IV <2µm", "detail": "<h3>🎯 Kích thước tiểu phân mục tiêu</h3><ul><li><b>Hít phế nang (Aerosol):</b> 1.0 - 5.0 µm (Hạt >15µm đập cổ họng; 5-15µm ở đường hô hấp trên; <5µm vào phế nang).</li><li><b>Nhỏ mắt (Ocular):</b> 0.1 - 3.0 µm (Giảm kích ứng cơ học cộm xốn).</li><li><b>Tiêm tĩnh mạch (IV):</b> 0.1 - 2.0 µm (Tránh tắc mạch máu).</li><li><b>Lắng đọng phổi:</b> Va đập quán tính (>6µm ở khí quản), Lắng đọng trọng lực (2-6µm ở phế quản), Khuếch tán (<2µm ở phế nang).</li></ul>" },
    { "id": 11, "label": "Đồ Thị Phân Bố Hạt Hình Chuông", "level": 3, "group": "mechanism", "tooltip": "💡 3 Ứng dụng đánh giá độ đồng đều & kiểm soát rây", "detail": "<h3>📊 Đồ thị phân phối chuẩn (Normal Distribution)</h3><ul><li><b>Căn cứ phân loại:</b> Dùng giá trị kích thước trung bình (đỉnh chuông).</li><li><b>Độ đồng đều:</b> Đồ thị càng hẹp dốc -> Độ đồng đều càng cao.</li><li><b>Nhận diện can thiệp:</b> Đồ thị bị cắt cụt rìa -> Đã qua rây phân loại chặn trên/dưới.</li></ul>" },

    { "id": 12, "label": "4 Giai Đoạn Biến Dạng Vật Liệu", "level": 3, "group": "mechanism", "tooltip": "💡 Đàn hồi -> Vết nứt vi mô -> Lan truyền -> Vỡ vụn", "detail": "<h3>🔨 Tiến trình vỡ vụn tiểu phân</h3><ol><li>Biến dạng đàn hồi (Elastic): Thuận nghịch.</li><li>Tạo vết nứt vi mô (Crack formation): Điều kiện tiên quyết. Khe hở làm bề mặt truyền lực mới.</li><li>Lan truyền vết nứt (Crack propagation): Lực tập trung cắt dọc mạng tinh thể.</li><li>Vỡ vụn (Fracture): Chia nhỏ thành nhiều mảnh.</li></ol>" },
    { "id": 13, "label": "4 Cơ Chế Nghiền Vật Lý", "level": 3, "group": "mechanism", "tooltip": "💡 Bẫy thi: Phương lực + Thời gian tác dụng", "detail": "<h3>⚙️ Bẫy trắc nghiệm kinh điển: 4 Cơ chế lực</h3><ul><li><b>Hướng tâm + Thời gian ngắn:</b> Va đập (Impact).</li><li><b>Hướng tâm + Thời gian dài:</b> Nén (Compression).</li><li><b>Tiếp tuyến + Thời gian dài:</b> Chà xát (Attrition).</li><li><b>Tiếp tuyến + Thời gian ngắn:</b> Cắt - xé (Cutting/Shearing).</li><li><b>Quy tắc:</b> Lực thời gian ngắn có hiệu suất tức thời cao nhưng nghiền mịn kém hơn lực thời gian dài.</li></ul>" },
    { "id": 14, "label": "Độ Nghiền (i=D/d) & Động Học", "level": 3, "group": "mechanism", "tooltip": "💡 dD/dt = -k * D^n (n=1, 1.5, 2)", "detail": "<h3>📈 Động học quá trình nghiền (Grinding Kinetics)</h3><p><b>dD/dt = -k × D^n</b></p><ul><li><b>Nghiền thô (n=1):</b> ln(D) tuyến tính với thời gian t. Giảm hạt một nửa tốn t phút.</li><li><b>Nghiền trung bình (n=1.5):</b> 1/√D tuyến tính với t. Giảm hạt một nửa tốn √2 × t phút.</li><li><b>Nghiền mịn (n=2):</b> 1/D tuyến tính với t. Giảm hạt một nửa tốn 2 × t phút.</li><li><b>Tư duy xưởng:</b> Kích thước càng mịn, thời gian chạy máy càng kéo dài dốc đứng -> Cần chọn điểm dừng tối ưu giữa năng lượng và độ đồng đều.</li></ul>" },

    { "id": 15, "label": "Cối Chày Quy Mô Nhỏ", "level": 3, "group": "application", "tooltip": "💡 Cối nhám nghiền hạt, Cối trơn trộn lỏng", "detail": "<h3>🧪 Dụng cụ Cối Chày</h3><ul><li><b>Cối sứ / Thủy tinh nhám:</b> Bề mặt nhám tạo ma sát nghiền hạt. Thao tác: Dùng lực cả cánh tay.</li><li><b>Cối thủy tinh trơn:</b> Trộn chất lỏng/thuốc mỡ (không có ma sát, không nghiền được). Thao tác: Xoay nhẹ cổ tay.</li><li><b>Cối đá mã não:</b> Bề mặt siêu cứng, nghiền chất cứng/màu tránh nhiễm bụi cối.</li></ul>" },
    { "id": 16, "label": "Máy Nghiền Búa (Hammer Mill)", "level": 3, "group": "application", "tooltip": "💡 Cơ chế Va Đập (Impact) tốc độ cao", "detail": "<h3>🔨 Máy nghiền búa</h3><p>Rotor quay tốc độ cao mang các búa đập vỡ vật liệu giòn cứng. Hạt nhỏ hơn lỗ rây rơi xuống lưới đáy.</p><ul><li><b>Cải tiến 1 (Lưới rây Omega):</b> Đẩy lưới sát búa -> Thêm cơ chế Chà xát mài mịn bột.</li><li><b>Cải tiến 2 (Luồng khí thổi):</b> Ép hạt mịn siêu nhẹ thoát qua lưới, chống bay bồng bềnh nghẽn buồng.</li></ul>" },
    { "id": 17, "label": "Máy Nghiền Bi (Ball Mill)", "level": 3, "group": "application", "tooltip": "💡 Thể thác rơi Cascade (70-80% Nc): Va đập + Chà xát", "detail": "<h3>🟢 Máy nghiền bi</h3><p>Trống quay chứa bi (40-50% thể tích). 3 Trạng thái tốc độ quay:</p><ul><li>Quay chậm (Thể bập bềnh): Bi lăn đáy, chỉ chà xát, hiệu quả kém.</li><li>Quay quá nhanh (Thể ly tâm): Lực ly tâm ghim bi vào thành trống, KHÔNG nghiền.</li><li>Quay tối ưu (70-80% Nc): Thể thác rơi (Cascade) -> Bi rơi tự do tạo <b>Va đập + Chà xát</b> cực mạnh. Công thức Nc = 42.3 / √D (m).</li></ul>" },
    { "id": 18, "label": "Bẫy Ma Sát Nhiệt & Vô Định Hình", "level": 4, "group": "resistance", "tooltip": "💡 CẤM DÙNG máy nghiền bi cho chất nhạy nhiệt / Protein", "detail": "<h3>⚠️ CẢNH BÁO BẪY THI: Ma sát nhiệt khổng lồ</h3><p>Máy nghiền bi sinh nhiệt ma sát cực cao. <b>CẤM DÙNG</b> cho dược chất có nhiệt độ nóng chảy thấp (<90°C), chất nhạy nhiệt, Protein, Enzyme, mAbs (gây chảy dẻo, vô định hình hóa, phân hủy hóa học).</p>" },
    { "id": 19, "label": "Máy Nghiền Phản Lực (Jet Mill)", "level": 3, "group": "application", "tooltip": "💡 Tự va đập dòng khí nén + Bánh xe phân loại", "detail": "<h3>💨 Máy nghiền năng lượng động (Jet Mill)</h3><p>Bố trí 3 súng phun khí nén góc 120° tạo lốc xoáy cho hạt <i>tự va đập đối đầu</i>. Bánh xe phân loại quay ở tâm tạo rào cản cơ học: Chỉ hạt siêu mịn (bóng bàn) lách qua, hạt thô (bóng đá) bị đập văng ngược lại nghiền tiếp.</p>" },
    { "id": 20, "label": "Bảo Vệ Hoạt Chất Nhạy Nhiệt Tối Thượng", "level": 4, "group": "application", "tooltip": "💡 Khí nén giãn nở thu nhiệt làm mát tự động", "detail": "<h3>❄️ Giải pháp hoàn hảo cho chất nhạy nhiệt</h3><ul><li>Hạt tự va đập giữa dòng khí -> Ma sát kim loại bằng ZERO.</li><li>Khí nén cao áp phun ra giãn nở thể tích đột ngột -> Quá trình THU NHIỆT cực mạnh làm mát buồng nghiền tự động.</li><li>Lựa chọn tối thượng cho Protein, Enzyme, mAbs, Hoạt chất sinh học.</li></ul>" }
